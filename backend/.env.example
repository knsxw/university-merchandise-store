PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:merch_secure_pass@localhost:3306/merch_store"

# JWT Secret
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins permitted to call the production API.
CORS_ORIGINS=http://localhost:5173

# Microsoft Entra ID (Azure AD)
# AZURE_CLIENT_ID must be a real app-registration ID to enforce verified ID-token login.
# With placeholders, /auth/microsoft falls back to unverified dev-mode profile exchange.
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here

# Emails (comma-separated) automatically granted the Admin role on first Entra ID login.
# Staff roles are assigned afterwards via Admin user management.
ADMIN_EMAILS=admin@university.edu

# Azure Key Vault (Optional)
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_URI=

# OpenAI API (Product Description Generation)
# Optional fallback. The preferred way is Admin Dashboard → Site Settings (stored in DB),
# which supports any OpenAI-compatible provider via a custom Base URL.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Peer API Integration
PEER_EDUCORE_API_URL=https://api.educore.mock/api
PEER_EDUCORE_API_KEY=educore_partner_secret_key_12345

# Exposed Peer API Secret (Header: x-api-key)
PARTNER_EXPOSED_API_KEY=partner_incoming_api_key_98765
