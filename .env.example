# ==========================================
# SMART UNIVERSITY MERCHANDISE STORE ENV CONFIG
# ==========================================

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=merch_secure_pass
DB_NAME=merch_store
DATABASE_URL="mysql://root:merch_secure_pass@mysql:3306/merch_store"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins permitted to call the production API.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Microsoft Entra ID (Active Directory) Auth
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here

# Emails (comma-separated) granted the Admin role on first Entra ID login
ADMIN_EMAILS=admin@university.edu

# Azure Key Vault service-principal connection
AZURE_CLIENT_SECRET=
KEY_VAULT_URL=https://your-vault-name.vault.azure.net

# Default AI model (the Admin Dashboard database setting takes precedence)
OPENAI_MODEL=gpt-4o-mini

# Public weather API and campus location (Open-Meteo requires no API key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
CAMPUS_LATITUDE=13.6123
CAMPUS_LONGITUDE=100.8373
CAMPUS_LOCATION_NAME=Assumption University, Suvarnabhumi Campus

# Exposed Partner API Key (For partner systems calling GET /api/products/available)
PARTNER_EXPOSED_API_KEY=partner_incoming_api_key_98765

# Frontend Configuration
# VITE_API_URL stays empty for Docker (nginx routes /api to the backend container).
# Only set it (http://localhost:5000/api) for bare-metal Vite dev in frontend/.env.
VITE_API_URL=
VITE_AZURE_CLIENT_ID=your_azure_client_id_here
VITE_AZURE_TENANT_ID=your_azure_tenant_id_here
VITE_AZURE_REDIRECT_URI=

# Production HTTPS bootstrap (used by scripts/init-letsencrypt.sh)
CERTBOT_DOMAIN=store.example.edu
CERTBOT_EMAIL=admin@example.edu
