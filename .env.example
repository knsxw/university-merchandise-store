# ==========================================
# SMART UNIVERSITY MERCHANDISE STORE ENV CONFIG
# ==========================================

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=merch_secure_pass
DB_NAME=merch_store
DATABASE_URL="mysql://root:merch_secure_pass@mysql:3306/merch_store"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=7d

# Microsoft Entra ID (Active Directory) Auth
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here

# Azure Key Vault (Optional for Cloud Production)
AZURE_KEY_VAULT_NAME=
AZURE_KEY_VAULT_URI=

# OpenAI API (Product Description Generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Peer API Configuration
# EduCore API (Consuming another team's Course Registration API for department discount check)
PEER_EDUCORE_API_URL=https://api.educore.mock/api
PEER_EDUCORE_API_KEY=educore_partner_secret_key_12345

# Exposed Partner API Key (For partner systems calling GET /api/products/available)
PARTNER_EXPOSED_API_KEY=partner_incoming_api_key_98765

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api
VITE_AZURE_CLIENT_ID=your_azure_client_id_here
VITE_AZURE_TENANT_ID=your_azure_tenant_id_here
